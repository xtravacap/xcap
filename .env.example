# --- Database (Postgres) ---
# Local/dev: matches docker-compose.yml. Production: use your managed Postgres URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xcap?schema=public"

# --- Clerk (Authentication) ---
# Get real keys from https://dashboard.clerk.com after creating an application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk Dashboard > Webhooks > add endpoint at /api/webhooks/clerk, subscribe to user.created/user.updated
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Comma-separated emails that get auto-promoted to ADMIN on first sign-up (via the Clerk webhook).
ADMIN_EMAILS="admin@xtravacapital.com"

# --- Supabase Storage (documents) ---
# Project Settings > API in your Supabase project. Use the SERVICE ROLE key (server-only, never expose to the client).
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="..."
SUPABASE_STORAGE_BUCKET="documents"

# --- OpenAI (document extraction + lender guideline parsing) ---
OPENAI_API_KEY="sk-..."
# Optional override — defaults to a vision+structured-output capable model.
OPENAI_EXTRACTION_MODEL="gpt-4o-2024-08-06"

# --- Resend (email notifications) ---
# Without this set, emails are logged to the console instead of sent — useful for local dev.
RESEND_API_KEY=""
EMAIL_FROM="Xtrava Capital <notifications@xtravacapital.com>"
